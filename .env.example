# Copy this file to .env.local and fill in your real API keys.
# .env.local is git-ignored, so your keys are never committed.
#
# IMPORTANT SECURITY WARNING:
# Because this app calls AI providers directly from the device
# (no backend), EXPO_PUBLIC_ variables are inlined into the app
# bundle and are VISIBLE to anyone with access to the app. Do not
# use a production-critical key. For production, move these calls
# behind a backend server.
#
# NEVER put real keys in this .env.example file - it is committed
# to the repository.

# Google Gemini API key (for image generation + description)
# Get one at https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=

# Groq API key (for fast text generation, pricing, and
# Whisper speech-to-text transcription)
# Get one at https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=

# Backend URL that performs web search + enriched description generation.
# Run the server in /server (see server/README.md) and point this at it.
# Leave empty to call Groq directly from the app (no web-search enrichment).
# For web testing on the same computer: http://localhost:4000
# On a real phone, use your computer's LAN IP, e.g. http://192.168.1.10:4000
EXPO_PUBLIC_API_URL=
