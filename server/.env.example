# Copy this file to .env and fill in your real keys.
# The .env file is git-ignored - never commit real keys.

# Tavily search API key - get a free key at https://tavily.com
TAVILY_API_KEY=

# Groq API key - get a free key at https://console.groq.com
GROQ_API_KEY=

# Google Gemini API key (used to analyze uploaded product photos)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Port the server listens on (default 4000)
PORT=4000
